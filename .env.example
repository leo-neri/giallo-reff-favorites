PORT=3000
SHOPIFY_SHOP=your-store.myshopify.com
# Prefer client credentials (Dev Dashboard apps). Static shpat_ token still works if set.
SHOPIFY_CLIENT_ID=your_app_client_id
SHOPIFY_API_SECRET=your_app_client_secret
# Optional fallback for legacy custom apps:
# SHOPIFY_ADMIN_API_ACCESS_TOKEN=shpat_xxxxxxxx
SHOPIFY_API_VERSION=2025-01
METAFIELD_NAMESPACE=giallo
METAFIELD_KEY=favorite_reffs
